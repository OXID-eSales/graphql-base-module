parameters:
    ignoreErrors:
        - identifier: missingType.iterableValue
        -
            # setDisableShopCheck() only exists on the EE BaseModel, not in CE.
            # reportUnmatched: false so this ignore does not error when analysing the EE edition.
            message: '#Call to an undefined method OxidEsales\\Eshop\\Core\\Model\\BaseModel::setDisableShopCheck\(\)#'
            identifier: method.notFound
            path: ../../src/Infrastructure/Repository.php
            reportUnmatched: false
    bootstrapFiles:
        - phpstan-bootstrap.php
    level: 8
    scanFiles:
        - ../../vendor/oxid-esales/oxideshop-ce/source/oxfunctions.php
        - ../../vendor/oxid-esales/oxideshop-ce/source/overridablefunctions.php

    inferPrivatePropertyTypeFromConstructor: true
    excludePaths:
        - *Component/Widget/GraphQL.php
        - *Seo/Infrastructure/Model/SeoEncoderArticle.php
